{
  "name": "multi-claude",
  "version": "0.1.0",
  "description": "Run Claude Code under the subscription account with headroom",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnsdls/multi-claude.git"
  },
  "homepage": "https://github.com/jnsdls/multi-claude#readme",
  "bugs": "https://github.com/jnsdls/multi-claude/issues",
  "bin": {
    "mclaude": "bin/mclaude"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:binaries": "bun run scripts/build.ts --compile",
    "test": "bun run build && bun test",
    "typecheck": "bunx tsc --noEmit",
    "check:drift": "bun run scripts/check-drift.ts",
    "extract:help": "bun run scripts/extract-claude-help.ts",
    "version": "bun run scripts/sync-platform-versions.ts && git add package.json",
    "publish:npm": "sh scripts/publish-npm.sh"
  },
  "optionalDependencies": {
    "multi-claude-darwin-arm64": "0.1.0",
    "multi-claude-darwin-x64": "0.1.0",
    "multi-claude-linux-x64": "0.1.0",
    "multi-claude-linux-arm64": "0.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
