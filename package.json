{
  "name": "mclaude",
  "version": "0.1.0",
  "description": "Run Claude Code under the subscription account with headroom",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnsdls/multi-claude.git"
  },
  "homepage": "https://github.com/jnsdls/multi-claude#readme",
  "bugs": "https://github.com/jnsdls/multi-claude/issues",
  "bin": {
    "mclaude": "bin/mclaude"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:binaries": "bun run scripts/build.ts --compile",
    "test": "bun run build && bun test",
    "typecheck": "bunx tsc --noEmit",
    "prepack": "bun run build",
    "check:drift": "bun run scripts/check-drift.ts",
    "extract:help": "bun run scripts/extract-claude-help.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
